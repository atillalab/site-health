#!/usr/bin/env bash
# File: bin/site-health
# Version: 0.7
# Last updated: 2026-08-14

VERSION="0.8"

show_usage() {
  echo "Usage: site-health [--mail] [--verbose] [--expected-url <url>] [--format <dashboard|json>] [--version] <domain>"
  echo "Example: site-health example.com"
  echo "Example: site-health --mail example.com"
  echo "Example: site-health --verbose example.com"
  echo "Example: site-health --expected-url https://example.org/ example.com"
  echo "Example: site-health --format json example.com"
}

EXPECTED_URL_OVERRIDE=""
EXPECTED_URL_WAS_PROVIDED=0
MAIL_ONLY=0
VERBOSE_OUTPUT=0
FORMAT="dashboard"
DOMAIN=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose)
      VERBOSE_OUTPUT=1
      shift
      ;;
    --format)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: --format requires a value." >&2
        show_usage
        exit 2
      fi

      FORMAT="$2"
      shift 2
      ;;
    --format=*)
      FORMAT="${1#--format=}"

      if [[ -z "$FORMAT" ]]; then
        echo "Error: --format requires a value." >&2
        show_usage
        exit 2
      fi

      shift
      ;;
    --mail)
      MAIL_ONLY=1
      shift
      ;;
    --expected-url)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: --expected-url requires a value." >&2
        show_usage
        exit 2
      fi

      EXPECTED_URL_OVERRIDE="$2"
      EXPECTED_URL_WAS_PROVIDED=1
      shift 2
      ;;
    --expected-url=*)
      EXPECTED_URL_OVERRIDE="${1#--expected-url=}"
      EXPECTED_URL_WAS_PROVIDED=1

      if [[ -z "$EXPECTED_URL_OVERRIDE" ]]; then
        echo "Error: --expected-url requires a value." >&2
        show_usage
        exit 2
      fi

      shift
      ;;
    -v|--version)
      echo "site-health $VERSION"
      exit 0
      ;;
    -h|--help)
      show_usage
      exit 0
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      show_usage
      exit 2
      ;;
    *)
      if [[ -n "$DOMAIN" ]]; then
        echo "Error: Multiple domains provided." >&2
        show_usage
        exit 2
      fi

      DOMAIN="$1"
      shift
      ;;
  esac
done

if [[ -z "$DOMAIN" ]]; then
  show_usage
  exit 2
fi

case "$FORMAT" in
  dashboard|text)
    FORMAT="dashboard"
    ;;
  json)
    ;;
  *)
    echo "Error: Unknown format: $FORMAT" >&2
    echo "Supported formats: dashboard, json" >&2
    exit 2
    ;;
esac

if [[ "$FORMAT" == "json" ]]; then
  VERBOSE_OUTPUT=0
fi

DOMAIN="${DOMAIN#http://}"
DOMAIN="${DOMAIN#https://}"
DOMAIN="${DOMAIN%%/*}"
DOMAIN="${DOMAIN%.}"

if [[ -z "$DOMAIN" ]]; then
  echo "Error: Invalid domain." >&2
  exit 2
fi

normalize_expected_url() {
  local value="$1"
  local without_fragment=""
  local scheme=""
  local rest=""
  local host=""
  local path_and_query=""

  case "$value" in
    http://*)
      scheme="http://"
      rest="${value#http://}"
      ;;
    https://*)
      scheme="https://"
      rest="${value#https://}"
      ;;
    *)
      return 1
      ;;
  esac

  without_fragment="${rest%%#*}"
  host="${without_fragment%%/*}"
  path_and_query="${without_fragment#"$host"}"

  if [[ -z "$host" ]]; then
    return 1
  fi

  if [[ -z "$path_and_query" ]]; then
    path_and_query="/"
  fi

  printf '%s%s%s\n' "$scheme" "$host" "$path_and_query"
}

url_host() {
  local value="$1"

  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  value="${value%%:*}"

  printf '%s\n' "$value" | tr '[:upper:]' '[:lower:]'
}

DEFAULT_EXPECTED_URL="https://${DOMAIN}/"

if [[ -n "$EXPECTED_URL_OVERRIDE" ]]; then
  EXPECTED_URL=$(normalize_expected_url "$EXPECTED_URL_OVERRIDE" || true)

  if [[ -z "$EXPECTED_URL" ]]; then
    echo "Error: --expected-url must be a valid absolute http:// or https:// URL." >&2
    exit 2
  fi
else
  EXPECTED_URL="$DEFAULT_EXPECTED_URL"
fi

EXPECTED_HOST=$(url_host "$EXPECTED_URL")
FORWARDING_HINT_URL=""
FORWARDING_AUTO_DETECTED=0
FORWARDING_AMBIGUOUS=0
FORWARDING_CANDIDATES=()

CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=10

SSL_EXPIRY_WARNING_DAYS=30
SSL_EXPIRY_WARNING_SECONDS=$((SSL_EXPIRY_WARNING_DAYS * 24 * 60 * 60))

DOMAIN_EXPIRY_WARNING_DAYS=30
DOMAIN_EXPIRY_CRITICAL_DAYS=7

# Performans eşikleri
SLOW_RESPONSE_WARNING_SECONDS="3.0"
VERY_SLOW_RESPONSE_SECONDS="8.0"

# İsteğe bağlı içerik doğrulaması.
# Site içinde kesinlikle bulunması gereken benzersiz bir metin girilebilir.
# Boş bırakılırsa yalnızca geçerli HTML yapısı kontrol edilir.
EXPECTED_HTML_PATTERN=""

urls=(
  "http://$DOMAIN"
  "http://www.$DOMAIN"
  "https://www.$DOMAIN"
  "https://$DOMAIN"
)

failures=0
warnings=0

ISSUE_LEVELS=()
ISSUE_MESSAGES=()

DNS_STATUS="OK"
HTTPS_STATUS="OK"
SSL_STATUS="OK"
SSL_DAYS_REMAINING=""
REDIRECT_STATUS="OK"
RESPONSE_STATUS="OK"
RESPONSE_MS=""
MAIL_STATUS="OK"
MX_STATUS="OK"
SPF_STATUS="OK"
DMARC_STATUS="OK"

DOMAIN_DAYS_REMAINING=""
domain_registrar=""
domain_expires_at=""
cert_subject=""
cert_issuer=""
cert_expires_at=""

a_records=""
aaaa_records=""
mx_records=""
spf_records=""
dmarc_policy_records=""

if [[ -t 1 ]]; then
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  YELLOW=$'\033[33m'
  CYAN=$'\033[36m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  GREEN=""
  RED=""
  YELLOW=""
  CYAN=""
  BOLD=""
  RESET=""
fi

pass() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "${GREEN}PASS${RESET}  $*"
  fi
}

fail() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "${RED}FAIL${RESET}  $*"
  fi
  ISSUE_LEVELS+=("FAIL")
  ISSUE_MESSAGES+=("$*")
  failures=$((failures + 1))
}

warn() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "${YELLOW}WARN${RESET}  $*"
  fi
  ISSUE_LEVELS+=("WARN")
  ISSUE_MESSAGES+=("$*")
  warnings=$((warnings + 1))
}

critical() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "${RED}CRIT${RESET}  $*"
  fi
  ISSUE_LEVELS+=("FAIL")
  ISSUE_MESSAGES+=("$*")
  failures=$((failures + 1))
}

info() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "${CYAN}INFO${RESET}  $*"
  fi
}

section() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo
    echo "${BOLD}== $* ==${RESET}"
  fi
}

indent() {
  sed 's/^/      → /'
}

detail() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    echo "$*"
  fi
}

detail_indent() {
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    indent
  else
    cat >/dev/null
  fi
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

same_site_host() {
  local host="$1"
  local domain=""
  local apex_domain=""

  domain=$(printf '%s\n' "$DOMAIN" | tr '[:upper:]' '[:lower:]')
  apex_domain="${domain#www.}"

  [[ "$host" == "$domain" ||
    "$host" == "www.$domain" ||
    "$host" == "$apex_domain" ||
    "$host" == "www.$apex_domain" ]]
}

float_greater_than() {
  awk -v left="$1" -v right="$2" 'BEGIN {
    exit !(left > right)
  }'
}

seconds_to_ms() {
  awk -v seconds="$1" 'BEGIN {
    if (seconds == "") {
      print ""
    } else {
      printf "%.0f", seconds * 1000
    }
  }'
}

set_status() {
  local variable_name="$1"
  local new_status="$2"
  local current_status="${!variable_name}"

  if [[ "$current_status" == "FAIL" ]]; then
    return
  fi

  if [[ "$new_status" == "FAIL" || "$current_status" == "" ]]; then
    printf -v "$variable_name" '%s' "$new_status"
    return
  fi

  if [[ "$new_status" == "WARN" && "$current_status" == "OK" ]]; then
    printf -v "$variable_name" '%s' "$new_status"
  fi
}

status_color() {
  case "$1" in
    OK|HEALTHY)
      printf '%s' "$GREEN"
      ;;
    WARN|WARNING)
      printf '%s' "$YELLOW"
      ;;
    FAIL|UNHEALTHY)
      printf '%s' "$RED"
      ;;
    *)
      printf '%s' "$RESET"
      ;;
  esac
}

overall_status() {
  if [[ $failures -gt 0 ]]; then
    echo "UNHEALTHY"
  elif [[ $warnings -gt 0 ]]; then
    echo "WARNING"
  else
    echo "HEALTHY"
  fi
}

sync_mail_status() {
  MAIL_STATUS="OK"
  set_status MAIL_STATUS "$MX_STATUS"
  set_status MAIL_STATUS "$SPF_STATUS"
  set_status MAIL_STATUS "$DMARC_STATUS"
}

parse_epoch() {
  local value="$1"
  local parsed_epoch=""
  local formats=(
    "%Y-%m-%dT%H:%M:%SZ"
    "%Y-%m-%dT%H:%M:%S%z"
    "%Y-%m-%d %H:%M:%S"
    "%Y-%m-%d"
    "%d-%b-%Y"
    "%b %e %H:%M:%S %Y %Z"
    "%b %d %H:%M:%S %Y %Z"
  )

  if date -u -d "$value" +%s >/dev/null 2>&1; then
    date -u -d "$value" +%s
    return 0
  fi

  for format in "${formats[@]}"; do
    parsed_epoch=$(date -j -u -f "$format" "$value" +%s 2>/dev/null || true)

    if [[ -n "$parsed_epoch" ]]; then
      echo "$parsed_epoch"
      return 0
    fi
  done

  return 1
}

extract_domain_expiry_date() {
  awk -F: '
    {
      key = tolower($1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    }
    key ~ /^(registry expiry date|registrar registration expiration date|expiration date|expiry date|paid-till)$/ {
      value = $0
      sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)

      if (value != "") {
        print value
        exit
      }
    }
  '
}

extract_domain_registrar() {
  awk -F: '
    {
      key = tolower($1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    }
    key ~ /^(registrar|registrar name|sponsoring registrar)$/ {
      value = $0
      sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)

      if (value != "") {
        print value
        exit
      }
    }
  '
}

describe_curl_error() {
  local exit_code="$1"
  local error_message="$2"

  case "$exit_code" in
    5)
      echo "proxy DNS çözümleme hatası"
      ;;
    6)
      echo "DNS çözümleme hatası"
      ;;
    7)
      echo "TCP bağlantısı kurulamadı"
      ;;
    28)
      echo "istek zaman aşımına uğradı"
      ;;
    35)
      echo "TLS/SSL bağlantı hatası"
      ;;
    47)
      echo "çok fazla yönlendirme veya yönlendirme döngüsü"
      ;;
    51|60)
      echo "SSL sertifikası doğrulanamadı"
      ;;
    52)
      echo "sunucudan boş yanıt geldi"
      ;;
    56)
      echo "bağlantı sırasında veri aktarım hatası"
      ;;
    *)
      if [[ -n "$error_message" ]]; then
        echo "$error_message"
      else
        echo "curl hata kodu: $exit_code"
      fi
      ;;
  esac
}

probe_http_url() {
  local url="$1"
  local prefix="$2"
  local safe_name=""
  local curl_error_file=""
  local result=""

  safe_name=$(printf '%s' "$url" | tr -c '[:alnum:]' '_')
  curl_error_file="$TMP_DIR/${prefix}-${safe_name}.err"

  result=$(curl \
    --silent \
    --show-error \
    --location \
    --output /dev/null \
    --write-out "%{http_code}|%{url_effective}|%{num_redirects}|%{time_connect}|%{time_starttransfer}|%{time_total}" \
    --connect-timeout "$CONNECT_TIMEOUT_SECONDS" \
    --max-time "$REQUEST_TIMEOUT_SECONDS" \
    --max-redirs "$MAX_REDIRECTS" \
    "$url" \
    2>"$curl_error_file")

  HTTP_CURL_STATUS=$?
  HTTP_CURL_ERROR=$(cat "$curl_error_file")

  if [[ $HTTP_CURL_STATUS -ne 0 ]]; then
    return 1
  fi

  IFS="|" read -r \
    HTTP_STATUS \
    HTTP_FINAL_URL \
    HTTP_REDIRECTS \
    HTTP_CONNECT_TIME \
    HTTP_STARTTRANSFER_TIME \
    HTTP_TOTAL_TIME \
    <<< "$result"

  return 0
}

add_forwarding_candidate() {
  local candidate="$1"
  local existing=""

  for existing in "${FORWARDING_CANDIDATES[@]}"; do
    if [[ "$existing" == "$candidate" ]]; then
      return
    fi
  done

  FORWARDING_CANDIDATES+=("$candidate")
}

detect_forwarded_expected_url() {
  local url=""
  local final_host=""

  if [[ $EXPECTED_URL_WAS_PROVIDED -eq 1 ]]; then
    return
  fi

  if ! command_exists curl; then
    return
  fi

  for url in "${urls[@]}"; do
    if ! probe_http_url "$url" "forwarding"; then
      continue
    fi

    final_host=$(url_host "$HTTP_FINAL_URL")

    if [[ "$HTTP_STATUS" == "200" &&
      "$HTTP_FINAL_URL" != "$EXPECTED_URL" ]] &&
      ! same_site_host "$final_host"; then
      add_forwarding_candidate "$HTTP_FINAL_URL"
    fi
  done

  if [[ ${#FORWARDING_CANDIDATES[@]} -eq 1 ]]; then
    FORWARDING_HINT_URL="${FORWARDING_CANDIDATES[0]}"
    EXPECTED_URL="$FORWARDING_HINT_URL"
    EXPECTED_HOST=$(url_host "$EXPECTED_URL")
    FORWARDING_AUTO_DETECTED=1
  elif [[ ${#FORWARDING_CANDIDATES[@]} -gt 1 ]]; then
    FORWARDING_HINT_URL="${FORWARDING_CANDIDATES[0]}"
    FORWARDING_AMBIGUOUS=1
  fi
}

TMP_DIR=$(mktemp -d 2>/dev/null)

if [[ -z "$TMP_DIR" || ! -d "$TMP_DIR" ]]; then
  echo "Geçici çalışma dizini oluşturulamadı." >&2
  exit 1
fi

cleanup() {
  rm -rf "$TMP_DIR"
}

trap cleanup EXIT INT TERM

print_header() {
  echo "${BOLD}Site Health Check${RESET}"
  echo "Domain: $DOMAIN"

  if [[ $MAIL_ONLY -eq 1 ]]; then
    echo "Mode: Mail"
    return
  fi

  echo "Expected URL: $EXPECTED_URL"
  if [[ $FORWARDING_AUTO_DETECTED -eq 1 ]]; then
    info "Domain forwards to $EXPECTED_URL"
    info "Using forwarded URL as expected URL for this run"
  fi
}

check_required_commands() {
  local required_commands=()
  local command_name=""

  if [[ $MAIL_ONLY -eq 1 ]]; then
    required_commands=(dig)
  else
    required_commands=(
      curl
      dig
      nc
      openssl
      whois
    )
  fi

  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    section "Gerekli araçlar"
  fi

  for command_name in "${required_commands[@]}"; do
    if command_exists "$command_name"; then
      if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
        pass "$command_name bulundu"
      fi
    else
      case "$command_name" in
        curl)
          set_status HTTPS_STATUS "FAIL"
          set_status REDIRECT_STATUS "FAIL"
          set_status RESPONSE_STATUS "FAIL"
          ;;
        dig)
          set_status DNS_STATUS "FAIL"
          set_status MX_STATUS "FAIL"
          set_status SPF_STATUS "FAIL"
          set_status DMARC_STATUS "FAIL"
          ;;
        openssl)
          set_status SSL_STATUS "FAIL"
          ;;
      esac
      fail "$command_name bulunamadı"
    fi
  done
}

check_domain_registration() {
section "Alan adı kaydı"

if command_exists whois; then
  whois_error_file="$TMP_DIR/whois.err"
  whois_output=$(whois "$DOMAIN" 2>"$whois_error_file")
  whois_status=$?
  whois_error=$(cat "$whois_error_file")

  if [[ $whois_status -ne 0 ]]; then
    fail "Domain registration lookup failed: ${whois_error:-whois hata kodu: $whois_status}"
  else
    domain_registrar=$(printf '%s\n' "$whois_output" | extract_domain_registrar)

    if [[ -n "$domain_registrar" ]]; then
      info "Registrar: $domain_registrar"
    else
      info "Registrar could not be read"
    fi

    domain_expires_at=$(printf '%s\n' "$whois_output" | extract_domain_expiry_date)

    if [[ -z "$domain_expires_at" ]]; then
      fail "Domain registration expiry date could not be read"
    else
      domain_expires_epoch=$(parse_epoch "$domain_expires_at" || true)

      if [[ -z "$domain_expires_epoch" ]]; then
        fail "Domain registration expiry date could not be parsed: $domain_expires_at"
      else
        now_epoch=$(date -u +%s)
        DOMAIN_DAYS_REMAINING=$(((domain_expires_epoch - now_epoch) / 86400))
        domain_days_remaining_label="${BOLD}${DOMAIN_DAYS_REMAINING} days${RESET}"

        if (( DOMAIN_DAYS_REMAINING < 0 )); then
          fail "Domain registration expired $((-DOMAIN_DAYS_REMAINING)) days ago"
        elif (( DOMAIN_DAYS_REMAINING < DOMAIN_EXPIRY_CRITICAL_DAYS )); then
          critical "Domain registration expires in ${domain_days_remaining_label}"
        elif (( DOMAIN_DAYS_REMAINING <= DOMAIN_EXPIRY_WARNING_DAYS )); then
          warn "Domain registration expires in ${domain_days_remaining_label}"
        else
          pass "Domain registration expires in ${domain_days_remaining_label}"
        fi

        detail "      → expires: $domain_expires_at"
      fi
    fi
  fi
fi
}

check_dns() {
section "DNS"

if command_exists dig; then
  a_records=$(dig +short A "$DOMAIN" 2>/dev/null)
  aaaa_records=$(dig +short AAAA "$DOMAIN" 2>/dev/null)

  if [[ -n "$a_records" ]]; then
    pass "A $DOMAIN"
    printf '%s\n' "$a_records" | detail_indent
  else
    set_status DNS_STATUS "FAIL"
    fail "A $DOMAIN — IPv4 adresi bulunamadı"
  fi

  if [[ -n "$aaaa_records" ]]; then
    pass "AAAA $DOMAIN"
    printf '%s\n' "$aaaa_records" | detail_indent
  else
    info "AAAA $DOMAIN — IPv6 kaydı bulunamadı"
  fi

  www_a_records=$(dig +short A "www.$DOMAIN" 2>/dev/null)
  www_aaaa_records=$(dig +short AAAA "www.$DOMAIN" 2>/dev/null)
  www_cname_records=$(dig +short CNAME "www.$DOMAIN" 2>/dev/null)

  if [[ -n "$www_a_records" || -n "$www_aaaa_records" || -n "$www_cname_records" ]]; then
    pass "www.$DOMAIN çözümleniyor"

    if [[ -n "$www_cname_records" ]]; then
      printf '%s\n' "$www_cname_records" | detail_indent
    elif [[ -n "$www_a_records" ]]; then
      printf '%s\n' "$www_a_records" | detail_indent
    else
      printf '%s\n' "$www_aaaa_records" | detail_indent
    fi
  else
    set_status DNS_STATUS "FAIL"
    fail "www.$DOMAIN — DNS kaydı bulunamadı"
  fi
fi
}

check_tcp() {
section "TCP portları"

if command_exists nc; then
  if nc -z -w "$CONNECT_TIMEOUT_SECONDS" "$DOMAIN" 80 >/dev/null 2>&1; then
    pass "TCP $DOMAIN:80 erişilebilir"
  else
    set_status REDIRECT_STATUS "FAIL"
    fail "TCP $DOMAIN:80 erişilemiyor"
  fi

  if nc -z -w "$CONNECT_TIMEOUT_SECONDS" "$DOMAIN" 443 >/dev/null 2>&1; then
    pass "TCP $DOMAIN:443 erişilebilir"
  else
    set_status HTTPS_STATUS "FAIL"
    fail "TCP $DOMAIN:443 erişilemiyor"
  fi
fi
}

check_http() {
section "HTTP ve yönlendirmeler"

if command_exists curl; then
  for url in "${urls[@]}"; do
    if ! probe_http_url "$url" "curl"; then
      error_description=$(describe_curl_error "$HTTP_CURL_STATUS" "$HTTP_CURL_ERROR")
      set_status REDIRECT_STATUS "FAIL"
      if [[ "$url" == https://* ]]; then
        set_status HTTPS_STATUS "FAIL"
      fi
      fail "$url — $error_description"
      continue
    fi

    if [[ "$HTTP_STATUS" == "200" && "$HTTP_FINAL_URL" == "$EXPECTED_URL" ]]; then
      if [[ "$EXPECTED_HOST" != "$DOMAIN" ]]; then
        pass "$url — forwarded to expected URL"
      else
        pass "$url"
      fi
    else
      set_status REDIRECT_STATUS "FAIL"
      if [[ "$url" == https://* ]]; then
        set_status HTTPS_STATUS "FAIL"
      fi
      fail "$url"
    fi

    detail "      → final: $HTTP_FINAL_URL"
    detail "      → status: $HTTP_STATUS"
    detail "      → redirects: $HTTP_REDIRECTS"
    detail "      → connect: ${HTTP_CONNECT_TIME}s"
    detail "      → first byte: ${HTTP_STARTTRANSFER_TIME}s"
    detail "      → total: ${HTTP_TOTAL_TIME}s"

    if [[ "$HTTP_STATUS" != "200" ]]; then
      set_status REDIRECT_STATUS "FAIL"
      if [[ "$url" == https://* ]]; then
        set_status HTTPS_STATUS "FAIL"
      fi
      fail "$url — beklenen son durum kodu 200, gelen $HTTP_STATUS"
    fi

    if [[ "$HTTP_FINAL_URL" != "$EXPECTED_URL" ]]; then
      set_status REDIRECT_STATUS "FAIL"
      fail "$url — unexpected final URL, expected $EXPECTED_URL"
    fi

    if float_greater_than "$HTTP_TOTAL_TIME" "$VERY_SLOW_RESPONSE_SECONDS"; then
      set_status RESPONSE_STATUS "FAIL"
      fail "$url — yanıt süresi çok yüksek: ${HTTP_TOTAL_TIME}s"
    elif float_greater_than "$HTTP_TOTAL_TIME" "$SLOW_RESPONSE_WARNING_SECONDS"; then
      set_status RESPONSE_STATUS "WARN"
      warn "$url — yanıt süresi yüksek: ${HTTP_TOTAL_TIME}s"
    fi
  done
fi
}

check_content() {
section "Canonical sayfa içeriği"

if command_exists curl; then
  body_file="$TMP_DIR/page-body.html"
  headers_file="$TMP_DIR/page-headers.txt"
  content_error_file="$TMP_DIR/content.err"

  content_result=$(curl \
    --silent \
    --show-error \
    --location \
    --compressed \
    --dump-header "$headers_file" \
    --output "$body_file" \
    --write-out "%{http_code}|%{url_effective}|%{size_download}|%{content_type}|%{time_total}" \
    --connect-timeout "$CONNECT_TIMEOUT_SECONDS" \
    --max-time "$REQUEST_TIMEOUT_SECONDS" \
    --max-redirs "$MAX_REDIRECTS" \
    "$EXPECTED_URL" \
    2>"$content_error_file")

  content_curl_status=$?
  content_curl_error=$(cat "$content_error_file")

  if [[ $content_curl_status -ne 0 ]]; then
    error_description=$(describe_curl_error "$content_curl_status" "$content_curl_error")
    set_status HTTPS_STATUS "FAIL"
    set_status RESPONSE_STATUS "FAIL"
    fail "$EXPECTED_URL — içerik indirilemedi: $error_description"
  else
    IFS="|" read -r \
      content_status \
      content_final_url \
      content_size \
      content_type \
      content_total_time \
      <<< "$content_result"

    RESPONSE_MS=$(seconds_to_ms "$content_total_time")
    if float_greater_than "$content_total_time" "$VERY_SLOW_RESPONSE_SECONDS"; then
      set_status RESPONSE_STATUS "FAIL"
    elif float_greater_than "$content_total_time" "$SLOW_RESPONSE_WARNING_SECONDS"; then
      set_status RESPONSE_STATUS "WARN"
    fi

    detail "      → content-type: ${content_type:-bilinmiyor}"
    detail "      → downloaded: ${content_size:-0} bytes"

    if [[ "$content_status" == "200" ]]; then
      pass "Canonical sayfa 200 döndürüyor"
    else
      set_status HTTPS_STATUS "FAIL"
      fail "Canonical sayfa — beklenen 200, gelen $content_status"
    fi

    if [[ "$content_final_url" == "$EXPECTED_URL" ]]; then
      if [[ "$EXPECTED_HOST" != "$DOMAIN" ]]; then
        pass "Canonical sayfa beklenen yönlendirme hedefinde"
      else
        pass "Canonical sayfa beklenen URL'de"
      fi
    else
      set_status REDIRECT_STATUS "FAIL"
      fail "Canonical sayfa beklenmeyen URL'ye yönleniyor: $content_final_url"
    fi

    if [[ ! -s "$body_file" ]]; then
      set_status HTTPS_STATUS "FAIL"
      fail "Yanıt gövdesi boş"
    else
      pass "Yanıt gövdesi boş değil"
    fi

    if [[ "$content_type" == text/html* || "$content_type" == application/xhtml+xml* ]]; then
      pass "Content-Type HTML"
    else
      set_status HTTPS_STATUS "FAIL"
      fail "Beklenmeyen Content-Type: ${content_type:-bilinmiyor}"
    fi

    if grep -Eiq '<!doctype[[:space:]]+html|<html([[:space:]>])' "$body_file"; then
      pass "Yanıt geçerli bir HTML belge yapısı içeriyor"
    else
      set_status HTTPS_STATUS "FAIL"
      fail "Yanıtta HTML belge yapısı bulunamadı"
    fi

    page_title=$(
      LC_ALL=C tr '\n' ' ' < "$body_file" |
        LC_ALL=C sed -nE 's/.*<[Tt][Ii][Tt][Ll][Ee][^>]*>([^<]*)<\/[Tt][Ii][Tt][Ll][Ee]>.*/\1/p' |
        head -n 1
    )

    if [[ -n "$page_title" ]]; then
      pass "HTML title bulundu"
      detail "      → $page_title"
    else
      warn "HTML title bulunamadı"
    fi

    if [[ -n "$EXPECTED_HTML_PATTERN" ]]; then
      if grep -Fqi "$EXPECTED_HTML_PATTERN" "$body_file"; then
        pass "Beklenen içerik bulundu: $EXPECTED_HTML_PATTERN"
      else
        set_status HTTPS_STATUS "FAIL"
        fail "Beklenen içerik bulunamadı: $EXPECTED_HTML_PATTERN"
      fi
    fi

    application_error_pattern='
Fatal error|
Parse error|
Uncaught Error|
Uncaught Exception|
Error establishing a database connection|
There has been a critical error on this website|
The site is experiencing technical difficulties|
WordPress database error|
Allowed memory size of .* exhausted|
Call to undefined function|
Call to undefined method|
502 Bad Gateway|
503 Service Unavailable|
504 Gateway Time-out|
Internal Server Error
'

    compact_application_error_pattern=$(
      printf '%s' "$application_error_pattern" |
        tr -d '\n' |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
    )

    if grep -Eiq "$compact_application_error_pattern" "$body_file"; then
      set_status HTTPS_STATUS "FAIL"
      fail "HTML içinde uygulama, WordPress, PHP veya sunucu hata metni bulundu"

      grep -Eio "$compact_application_error_pattern" "$body_file" |
        sort -u |
        head -n 5 |
        detail_indent
    else
      pass "Bilinen WordPress/PHP/sunucu hata metni bulunmadı"
    fi

    parked_domain_pattern='
domain (is|has been) parked|
this domain is parked|
buy this domain|
domain for sale|
this domain may be for sale|
sedo domain parking|
afternic|
dan\.com|
hugedomains|
bodis|
parkingcrew|
namecheap parking page|
godaddy domain parking
'

    compact_parked_domain_pattern=$(
      printf '%s' "$parked_domain_pattern" |
        tr -d '\n' |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
    )

    if grep -Eiq "$compact_parked_domain_pattern" "$body_file"; then
      set_status HTTPS_STATUS "FAIL"
      fail "Alan adı park edilmiş olabilir"

      grep -Eio "$compact_parked_domain_pattern" "$body_file" |
        sort -u |
        head -n 5 |
        detail_indent
    else
      pass "Bilinen alan adı park sayfası izi bulunmadı"
    fi

    if grep -Eiq 'coming soon|under construction|website is under maintenance' "$body_file"; then
      set_status HTTPS_STATUS "WARN"
      warn "Sayfa bakım veya yakında açılacak sayfası olabilir"
    fi
  fi
fi
}

check_llms() {
section "llms.txt"

if command_exists curl; then
  llms_error_file="$TMP_DIR/llms.err"

  llms_result=$(curl \
    --silent \
    --show-error \
    --location \
    --output /dev/null \
    --write-out "%{http_code}|%{url_effective}|%{content_type}" \
    --connect-timeout "$CONNECT_TIMEOUT_SECONDS" \
    --max-time "$REQUEST_TIMEOUT_SECONDS" \
    --max-redirs "$MAX_REDIRECTS" \
    "https://$DOMAIN/llms.txt" \
    2>"$llms_error_file")

  llms_curl_status=$?
  llms_curl_error=$(cat "$llms_error_file")

  if [[ $llms_curl_status -ne 0 ]]; then
    error_description=$(describe_curl_error "$llms_curl_status" "$llms_curl_error")
    fail "/llms.txt — $error_description"
  else
    IFS="|" read -r llms_status llms_final_url llms_content_type <<< "$llms_result"

    if [[ "$llms_status" == "200" ]]; then
      pass "/llms.txt"
      detail "      → $llms_final_url"
      detail "      → content-type: ${llms_content_type:-bilinmiyor}"
    else
      fail "/llms.txt — beklenen 200, gelen $llms_status"
    fi
  fi
fi
}

check_mx() {
section "MX"

if command_exists dig; then
  mx_records=$(dig +short MX "$DOMAIN" 2>/dev/null)

  if [[ -n "$mx_records" ]]; then
    pass "MX $DOMAIN"
    printf '%s\n' "$mx_records" | detail_indent

    mx_record_count=$(
      printf '%s\n' "$mx_records" |
        awk 'NF { count++ } END { print count + 0 }'
    )

    null_mx_records=$(
      printf '%s\n' "$mx_records" |
        awk '$1 == "0" && $2 == "." { count++ } END { print count + 0 }'
    )

    if (( null_mx_records == 1 && mx_record_count == 1 )); then
      info "Null MX detected — this domain explicitly does not accept email"
    elif (( null_mx_records > 0 )); then
      info "Null MX record detected alongside other MX records"
    fi
  else
    set_status MX_STATUS "FAIL"
    fail "MX $DOMAIN — MX kaydı bulunamadı"
  fi
fi
}

check_spf() {
section "SPF"

if command_exists dig; then
  txt_records=$(
    dig +short TXT "$DOMAIN" 2>/dev/null |
      sed 's/"[[:space:]]*"//g; s/"//g'
  )

  spf_records=$(
    printf '%s\n' "$txt_records" |
      grep -Ei '^[[:space:]]*v=spf1([[:space:]]|$)' || true
  )

  spf_record_count=$(
    printf '%s\n' "$spf_records" |
      awk 'NF { count++ } END { print count + 0 }'
  )

  if (( spf_record_count == 0 )); then
    set_status SPF_STATUS "FAIL"
    fail "SPF $DOMAIN — SPF TXT kaydı bulunamadı"
  elif (( spf_record_count > 1 )); then
    set_status SPF_STATUS "FAIL"
    fail "SPF $DOMAIN — birden fazla SPF TXT kaydı bulundu"
    printf '%s\n' "$spf_records" | detail_indent
  else
    pass "SPF $DOMAIN"
    printf '%s\n' "$spf_records" | detail_indent
  fi
fi
}

check_dmarc() {
section "DMARC"

if command_exists dig; then
  dmarc_records=$(
    dig +short TXT "_dmarc.$DOMAIN" 2>/dev/null |
      sed 's/"[[:space:]]*"//g; s/"//g'
  )

  dmarc_policy_records=$(
    printf '%s\n' "$dmarc_records" |
      grep -Ei '^[[:space:]]*v=DMARC1([[:space:]]*;|[[:space:]]|$)' || true
  )

  dmarc_record_count=$(
    printf '%s\n' "$dmarc_policy_records" |
      awk 'NF { count++ } END { print count + 0 }'
  )

  if (( dmarc_record_count == 0 )); then
    set_status DMARC_STATUS "FAIL"
    fail "DMARC _dmarc.$DOMAIN — DMARC TXT kaydı bulunamadı"
    detail "      → Cloudflare uyarısı: @${DOMAIN} adreslerinden sahte e-postaları engellemek için DMARC kaydı ekleyin"
  elif (( dmarc_record_count > 1 )); then
    set_status DMARC_STATUS "FAIL"
    fail "DMARC _dmarc.$DOMAIN — birden fazla DMARC TXT kaydı bulundu"
    printf '%s\n' "$dmarc_policy_records" | detail_indent
  else
    dmarc_record=$(printf '%s\n' "$dmarc_policy_records" | head -n 1)
    normalized_dmarc_record=$(printf '%s' "$dmarc_record" | tr '[:upper:]' '[:lower:]')

    if [[ "$normalized_dmarc_record" =~ (^|[[:space:]]*;[[:space:]]*)p[[:space:]]*=[[:space:]]*(none|quarantine|reject)([[:space:]]*;|[[:space:]]*$) ]]; then
      dmarc_policy="${BASH_REMATCH[2]}"

      if [[ "$dmarc_policy" == "none" ]]; then
        set_status DMARC_STATUS "WARN"
        warn "DMARC _dmarc.$DOMAIN — policy p=none, yalnızca izleme modunda"
      else
        pass "DMARC _dmarc.$DOMAIN — policy p=$dmarc_policy"
      fi

      printf '%s\n' "$dmarc_record" | detail_indent
    else
      set_status DMARC_STATUS "FAIL"
      fail "DMARC _dmarc.$DOMAIN — geçerli p= politikası bulunamadı"
      printf '%s\n' "$dmarc_record" | detail_indent
    fi
  fi
fi
}

check_mail() {
  check_mx
  check_spf
  check_dmarc
  sync_mail_status
}

check_ssl() {
section "SSL sertifikası"

if command_exists openssl; then
  ssl_output=$(openssl s_client \
    -connect "$DOMAIN:443" \
    -servername "$DOMAIN" \
    -verify_hostname "$DOMAIN" \
    -verify_return_error \
    </dev/null 2>/dev/null)

  ssl_status=$?

  if [[ $ssl_status -ne 0 ]]; then
    set_status SSL_STATUS "FAIL"
    fail "SSL $DOMAIN — sertifika zinciri veya hostname doğrulanamadı"
  else
    certificate=$(
      printf '%s\n' "$ssl_output" |
        openssl x509 -outform PEM 2>/dev/null
    )

    if [[ -z "$certificate" ]]; then
      set_status SSL_STATUS "FAIL"
      fail "SSL $DOMAIN — sertifika okunamadı"
    else
      cert_subject=$(
        printf '%s\n' "$certificate" |
          openssl x509 -noout -subject 2>/dev/null |
          sed 's/^subject=//'
      )

      cert_issuer=$(
        printf '%s\n' "$certificate" |
          openssl x509 -noout -issuer 2>/dev/null |
          sed 's/^issuer=//'
      )

      cert_expires_at=$(
        printf '%s\n' "$certificate" |
          openssl x509 -noout -enddate 2>/dev/null |
          sed 's/^notAfter=//'
      )

      if [[ -z "$cert_expires_at" ]]; then
        set_status SSL_STATUS "FAIL"
        fail "SSL $DOMAIN — sertifika sona erme tarihi okunamadı"
      elif ! printf '%s\n' "$certificate" |
        openssl x509 \
          -checkend "$SSL_EXPIRY_WARNING_SECONDS" \
          -noout >/dev/null 2>&1; then
        cert_expires_epoch=$(parse_epoch "$cert_expires_at" || true)
        if [[ -n "$cert_expires_epoch" ]]; then
          now_epoch=$(date -u +%s)
          SSL_DAYS_REMAINING=$(((cert_expires_epoch - now_epoch) / 86400))
        fi
        set_status SSL_STATUS "WARN"
        warn "SSL $DOMAIN — sertifika $SSL_EXPIRY_WARNING_DAYS gün içinde sona erecek"
      else
        cert_expires_epoch=$(parse_epoch "$cert_expires_at" || true)
        if [[ -n "$cert_expires_epoch" ]]; then
          now_epoch=$(date -u +%s)
          SSL_DAYS_REMAINING=$(((cert_expires_epoch - now_epoch) / 86400))
        fi
        pass "SSL $DOMAIN"
      fi

      detail "      → subject: $cert_subject"
      detail "      → issuer: $cert_issuer"
      detail "      → expires: $cert_expires_at"
    fi
  fi
fi
}

json_escape() {
  local value="$1"
  local escaped=""
  local char=""
  local index=0
  local length="${#value}"

  for ((index = 0; index < length; index++)); do
    char="${value:index:1}"
    case "$char" in
      '"') escaped+='\"' ;;
      '\') escaped+='\\' ;;
      $'\t') escaped+='\t' ;;
      $'\r') escaped+='\r' ;;
      $'\n') escaped+='\n' ;;
      *) escaped+="$char" ;;
    esac
  done

  printf '%s' "$escaped"
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

json_string_or_null() {
  if [[ -z "$1" ]]; then
    printf 'null'
  else
    json_string "$1"
  fi
}

json_int_or_null() {
  if [[ -z "$1" ]]; then
    printf 'null'
  else
    printf '%s' "$1"
  fi
}

json_bool() {
  if [[ "$1" == "1" ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

json_array_of_strings() {
  local item=""
  local count=0

  if (( $# == 0 )); then
    printf '[]'
    return
  fi

  printf '['
  for item in "$@"; do
    if (( count > 0 )); then
      printf ','
    fi
    json_string "$item"
    count=$((count + 1))
  done
  printf ']'
}

json_array_from_lines() {
  local value="$1"
  local line=""
  local first=1

  if [[ -z "$value" ]]; then
    printf '[]'
    return
  fi

  printf '['
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      if [[ $first -eq 0 ]]; then
        printf ','
      fi
      json_string "$line"
      first=0
    fi
  done <<< "$value"
  printf ']'
}

json_domain_registration_status() {
  if [[ -n "$DOMAIN_DAYS_REMAINING" ]]; then
    if (( DOMAIN_DAYS_REMAINING < 0 || DOMAIN_DAYS_REMAINING < DOMAIN_EXPIRY_CRITICAL_DAYS )); then
      echo "FAIL"
    elif (( DOMAIN_DAYS_REMAINING <= DOMAIN_EXPIRY_WARNING_DAYS )); then
      echo "WARN"
    else
      echo "OK"
    fi
  else
    echo "SKIP"
  fi
}

render_json_mail_block() {
  local indent="$1"

  echo "${indent}\"mail\": {"
  echo "${indent}  \"status\": $(json_string "$MAIL_STATUS"),"
  echo "${indent}  \"mx\": { \"status\": $(json_string "$MX_STATUS"), \"records\": $(json_array_from_lines "$mx_records") },"
  echo "${indent}  \"spf\": { \"status\": $(json_string "$SPF_STATUS"), \"records\": $(json_array_from_lines "$spf_records") },"
  echo "${indent}  \"dmarc\": { \"status\": $(json_string "$DMARC_STATUS"), \"records\": $(json_array_from_lines "$dmarc_policy_records") }"
  echo "${indent}}"
}

render_json_site_checks() {
  echo '    "dns": {'
  echo "      \"status\": $(json_string "$DNS_STATUS"),"
  echo "      \"a\": $(json_array_from_lines "$a_records"),"
  echo "      \"aaaa\": $(json_array_from_lines "$aaaa_records")"
  echo '    },'
  echo "    \"https\": { \"status\": $(json_string "$HTTPS_STATUS") },"
  echo '    "ssl": {'
  echo "      \"status\": $(json_string "$SSL_STATUS"),"
  echo "      \"days_remaining\": $(json_int_or_null "$SSL_DAYS_REMAINING"),"
  echo "      \"subject\": $(json_string_or_null "$cert_subject"),"
  echo "      \"issuer\": $(json_string_or_null "$cert_issuer"),"
  echo "      \"expires_at\": $(json_string_or_null "$cert_expires_at")"
  echo '    },'
  echo "    \"redirect\": { \"status\": $(json_string "$REDIRECT_STATUS") },"
  echo '    "response": {'
  echo "      \"status\": $(json_string "$RESPONSE_STATUS"),"
  echo "      \"ms\": $(json_int_or_null "$RESPONSE_MS")"
  echo '    },'

  if [[ -n "$domain_registrar" || -n "$domain_expires_at" || -n "$DOMAIN_DAYS_REMAINING" ]]; then
    echo '    "domain_registration": {'
    echo "      \"status\": $(json_string "$(json_domain_registration_status)"),"
    echo "      \"registrar\": $(json_string_or_null "$domain_registrar"),"
    echo "      \"expires_at\": $(json_string_or_null "$domain_expires_at"),"
    echo "      \"days_remaining\": $(json_int_or_null "$DOMAIN_DAYS_REMAINING")"
    echo '    },'
  else
    echo '    "domain_registration": null,'
  fi

  render_json_mail_block "    "
}

render_json_mail_checks() {
  render_json_mail_block "    "
}

render_json() {
  local index=0
  local status=""

  status=$(overall_status)

  echo '{'
  echo "  \"tool\": \"site-health\","
  echo "  \"version\": $(json_string "$VERSION"),"
  echo "  \"domain\": $(json_string "$DOMAIN"),"

  if [[ $MAIL_ONLY -eq 1 ]]; then
    echo '  "mode": "mail",'
  else
    echo '  "mode": "site",'
    echo "  \"expected_url\": $(json_string "$EXPECTED_URL"),"
    echo '  "forwarding": {'
    echo "    \"auto_detected\": $(json_bool "$FORWARDING_AUTO_DETECTED"),"
    echo "    \"ambiguous\": $(json_bool "$FORWARDING_AMBIGUOUS"),"
    echo "    \"hint_url\": $(json_string_or_null "$FORWARDING_HINT_URL"),"
    echo "    \"candidates\": $(json_array_of_strings "${FORWARDING_CANDIDATES[@]}")"
    echo '  },'
  fi

  echo '  "checks": {'

  if [[ $MAIL_ONLY -eq 1 ]]; then
    render_json_mail_checks
  else
    render_json_site_checks
  fi

  echo '  },'
  echo '  "issues": ['

  if [[ ${#ISSUE_LEVELS[@]} -gt 0 ]]; then
    for ((index = 0; index < ${#ISSUE_LEVELS[@]}; index++)); do
      if (( index > 0 )); then
        echo '    },'
      fi
      printf '    { "level": %s, "message": %s' \
        "$(json_string "${ISSUE_LEVELS[$index]}")" \
        "$(json_string "${ISSUE_MESSAGES[$index]}")"
    done
    echo '    }'
  fi

  echo '  ],'
  echo '  "summary": {'
  echo "    \"failures\": $failures,"
  echo "    \"warnings\": $warnings,"
  echo "    \"status\": $(json_string "$status")"
  echo '  }'
  echo '}'
}

format_status_token() {
  local status="$1"
  local color=""

  color=$(status_color "$status")
  printf '%s%s%s' "$color" "$status" "$RESET"
}

render_status_row() {
  local label="$1"
  local value="$2"
  local status="$3"

  if [[ "$status" == "WARN" ]]; then
    printf '  %-12s %s    %s%s WARN%s\n' "$label" "$value" "$YELLOW" "⚠" "$RESET"
  elif [[ "$status" == "FAIL" ]]; then
    printf '  %-12s %s    %s%s FAIL%s\n' "$label" "$value" "$RED" "✖" "$RESET"
  else
    printf '  %-12s %s\n' "$label" "$value"
  fi
}

render_simple_status_row() {
  local label="$1"
  local status="$2"

  printf '  %-12s %s\n' "$label" "$(format_status_token "$status")"
}

should_show_dashboard_expected_url() {
  [[ $EXPECTED_URL_WAS_PROVIDED -eq 1 ||
    $FORWARDING_AUTO_DETECTED -eq 1 ||
    $FORWARDING_AMBIGUOUS -eq 1 ||
    -n "$FORWARDING_HINT_URL" ||
    "$REDIRECT_STATUS" != "OK" ]]
}

render_issues() {
  local index=0
  local printed=0
  local max_issues=10
  local level=""
  local message=""
  local color=""

  if [[ ${#ISSUE_LEVELS[@]} -eq 0 ]]; then
    return
  fi

  echo
  echo "Issues:"

  for ((index = 0; index < ${#ISSUE_LEVELS[@]}; index++)); do
    if (( printed >= max_issues )); then
      printf '  ...  %d more; run with --verbose for full diagnostics\n' "$((${#ISSUE_LEVELS[@]} - printed))"
      break
    fi

    level="${ISSUE_LEVELS[$index]}"
    message="${ISSUE_MESSAGES[$index]}"
    color=$(status_color "$level")
    printf '  %s%-4s%s  %s\n' "$color" "$level" "$RESET" "$message"
    printed=$((printed + 1))
  done
}

render_dashboard() {
  local status=""
  local ssl_value=""
  local response_value=""
  local status_color_value=""

  echo "${BOLD}SITE HEALTH${RESET}"
  echo "───────────"
  echo "● $DOMAIN"

  if should_show_dashboard_expected_url; then
    printf '  %-12s %s\n' "Expected" "$EXPECTED_URL"
  fi

  render_simple_status_row "HTTPS" "$HTTPS_STATUS"
  render_simple_status_row "DNS" "$DNS_STATUS"

  if [[ "$SSL_STATUS" == "FAIL" ]]; then
    ssl_value="$(format_status_token FAIL)"
    render_status_row "SSL" "$ssl_value" "OK"
  elif [[ -n "$SSL_DAYS_REMAINING" ]]; then
    render_status_row "SSL" "${SSL_DAYS_REMAINING} days" "$SSL_STATUS"
  else
    render_simple_status_row "SSL" "$SSL_STATUS"
  fi

  render_simple_status_row "Redirect" "$REDIRECT_STATUS"

  if [[ -n "$RESPONSE_MS" ]]; then
    response_value="${RESPONSE_MS} ms"
    render_status_row "Response" "$response_value" "$RESPONSE_STATUS"
  else
    response_value="—"
    render_status_row "Response" "$response_value" "OK"
  fi

  render_simple_status_row "Mail" "$MAIL_STATUS"

  status=$(overall_status)
  status_color_value=$(status_color "$status")
  echo "Status: ${status_color_value}${status}${RESET}"

  render_issues
  print_forwarding_hint
}

render_mail_dashboard() {
  local status=""
  local status_color_value=""

  echo "${BOLD}MAIL HEALTH${RESET}"
  echo "───────────"
  echo "● $DOMAIN"
  render_simple_status_row "MX" "$MX_STATUS"
  render_simple_status_row "SPF" "$SPF_STATUS"
  render_simple_status_row "DMARC" "$DMARC_STATUS"

  status=$(overall_status)
  status_color_value=$(status_color "$status")
  echo "Status: ${status_color_value}${status}${RESET}"

  render_issues
}

finish_dashboard() {
  if [[ $MAIL_ONLY -eq 1 ]]; then
    render_mail_dashboard
  else
    render_dashboard
  fi

  if [[ $failures -gt 0 ]]; then
    exit 1
  fi

  exit 0
}

print_forwarding_hint() {
  local candidate=""

  if [[ $FORWARDING_AUTO_DETECTED -eq 1 ]]; then
    return
  fi

  if [[ $FORWARDING_AMBIGUOUS -eq 1 ]]; then
    info "Domain appears to forward to multiple URLs"
    for candidate in "${FORWARDING_CANDIDATES[@]}"; do
      detail "      → candidate: $candidate"
    done
    detail "      → choose one: site-health --expected-url <url> $DOMAIN"
  elif [[ -n "$FORWARDING_HINT_URL" ]]; then
    info "Domain looks forwarded to $FORWARDING_HINT_URL"
    detail "      → suggested: site-health --expected-url $FORWARDING_HINT_URL $DOMAIN"
  fi
}

print_summary() {
  section "Sonuç"

  if [[ $MAIL_ONLY -eq 1 ]]; then
    if [[ $failures -gt 0 ]]; then
      echo "${RED}${BOLD}Mail sağlık kontrolü başarısız.${RESET}"
      echo "Failures: $failures"
      echo "Warnings: $warnings"
      exit 1
    fi

    if [[ $warnings -gt 0 ]]; then
      echo "${YELLOW}${BOLD}Mail kontrolleri tamamlandı, ancak $warnings uyarı bulundu.${RESET}"
    else
      echo "${GREEN}${BOLD}Tüm mail kontrolleri başarılı.${RESET}"
    fi

    echo "Failures: $failures"
    echo "Warnings: $warnings"
    exit 0
  fi

  if [[ $failures -gt 0 ]]; then
    echo "${RED}${BOLD}Site sağlık kontrolü başarısız.${RESET}"
    echo "Failures: $failures"
    echo "Warnings: $warnings"
    print_forwarding_hint
    exit 1
  fi

  if [[ $warnings -gt 0 ]]; then
    echo "${YELLOW}${BOLD}Site çalışıyor, ancak $warnings uyarı bulundu.${RESET}"
  else
    echo "${GREEN}${BOLD}Tüm kontroller başarılı.${RESET}"
  fi

  echo "Failures: $failures"
  echo "Warnings: $warnings"

  print_forwarding_hint

  exit 0
}

check_all() {
  check_domain_registration
  check_dns
  check_tcp
  check_http
  check_content
  check_llms
  check_mail
  check_ssl
}

if [[ $MAIL_ONLY -eq 1 ]]; then
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    print_header
  fi
  check_required_commands
  check_mail
else
  detect_forwarded_expected_url
  if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
    print_header
  fi
  check_required_commands
  check_all
fi

if [[ "$FORMAT" == "json" ]]; then
  render_json

  if [[ $failures -gt 0 ]]; then
    exit 1
  fi

  exit 0
fi

if [[ $VERBOSE_OUTPUT -eq 1 ]]; then
  print_summary
else
  finish_dashboard
fi
